{
  "note": "ナレーションの台本。start は動画の実時間（秒）。順番と文は変更しないこと。",
  "lines": [
    {
      "id": "01",
      "start": 0.3,
      "text": "この海の未来、あなたが決める。"
    },
    {
      "id": "02",
      "start": 3.4,
      "text": "みんなの投票で、世界が変わる。"
    },
    {
      "id": "03",
      "start": 7.2,
      "text": "どの世界を始める？"
    },
    {
      "id": "04",
      "start": 9.0,
      "text": "海を育てる。水族館を作る。海底を調査する。"
    },
    {
      "id": "05",
      "start": 13.1,
      "text": "海を育てる。小さな海から、生き物たちの世界へ。"
    },
    {
      "id": "06",
      "start": 17.2,
      "text": "水族館を作る。何もない場所に、理想の水族館を。"
    },
    {
      "id": "07",
      "start": 21.7,
      "text": "海底を調査する。まだ知らない発見がある。"
    },
    {
      "id": "08",
      "start": 25.5,
      "text": "あなたはどれを選ぶ？ コメントに、1、2、3を送って投票。"
    },
    {
      "id": "09",
      "start": 32.4,
      "text": "次回、あなたの選択で世界が動く。フォローして見届けて。"
    }
  ]
}
